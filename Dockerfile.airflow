# One image for airflow, ingest-api and file-watcher (saves disk + download time).
FROM apache/airflow:slim-2.10.4-python3.12

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
USER airflow

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Pre-install DuckDB's postgres extension so the transform does not need internet at run time
RUN python -c "import duckdb; c = duckdb.connect(); c.execute('INSTALL postgres'); print('duckdb postgres extension installed')"

ENV PYTHONPATH=/opt/project \
    PROJECT_ROOT=/opt/project
WORKDIR /opt/project

{
  "uid": "sdi-batch-ingestion",
  "title": "01 Batch Ingestion",
  "description": "Per-file batch loads: duration, rows, success rate, rejects",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": [
    "sdi",
    "phase1",
    "monitoring"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "15s",
      "30s",
      "1m"
    ]
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Batch success rate %",
      "description": "successful / attempted x 100 (all batch files ever ingested)",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status = 'success') / nullif(count(*), 0), 1) AS success_rate FROM monitoring.batch_ingestion_log"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Files ingested",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS files FROM monitoring.batch_ingestion_log"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rows loaded to staging",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(rows_loaded) AS rows_loaded FROM monitoring.batch_ingestion_log"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rows rejected",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(rows_rejected) AS rows_rejected FROM monitoring.batch_ingestion_log"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Load duration (s) per source file",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT file_name, duration_seconds FROM monitoring.batch_ingestion_log ORDER BY id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 40,
        "xField": "file_name"
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Rows processed per batch (loaded vs rejected)",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT file_name, rows_loaded, rows_rejected FROM monitoring.batch_ingestion_log ORDER BY id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 40,
        "xField": "file_name"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Rejected rows by reason",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT source || ': ' || rejection_reason AS reason, count(*) AS rejected_rows FROM staging.rejected_rows GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 40,
        "xField": "reason"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rows loaded over time",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT end_ts AS time, source AS metric, rows_loaded AS value FROM monitoring.batch_ingestion_log WHERE $__timeFilter(end_ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Batch log",
      "description": "",
      "datasource": {
        "uid": "pg-monitoring"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "pg-monitoring"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id, run_id, file_name, source, start_ts, duration_seconds, rows_read, rows_loaded, rows_rejected, status, error_message FROM monitoring.batch_ingestion_log ORDER BY id DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Other dashboards",
      "type": "dashboards",

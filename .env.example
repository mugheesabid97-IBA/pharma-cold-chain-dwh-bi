# Copy to .env (cp .env.example .env). The real .env is git-ignored.

# --- Postgres (staging + monitoring live in database pharma_dwh)
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma_pw
POSTGRES_DB=pharma_dwh
# host port (5433 avoids clashing with a locally installed Postgres)
POSTGRES_HOST_PORT=5433

# Airflow metadata database (separate DB in the same Postgres server)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_pw

# Read-only user used by Grafana
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=grafana_pw

# --- Airflow UI + REST API login (http://localhost:8080)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_SECRET_KEY=change-me-sdi-phase1
AIRFLOW_UID=50000

# --- Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Pipeline settings
GEN_SALES_ROWS_PER_MONTH=14000
GEN_STREAM_ROWS=3000
GEN_BAD_ROW_SHARE=0.01
STREAM_ROWS_PER_SEC=25
SDI_PIPELINE_SCHEDULE=
